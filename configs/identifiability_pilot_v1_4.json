  "design": {
    "name": "balanced_paired_mechanism_identifiability_pilot",
    "independence_unit": "scene_seed",
    "episodes_per_scene_seed": 3,
    "mechanism_crossing": "each_scene_seed_generates_one_clean_one_actuator_and_one_observation_episode",
    "factor_crossing": "the same scene_seed_factors row is reused for both fault mechanisms; mechanism is never encoded by a factor row",
    "pilot_is_evaluation_only": true,
    "pilot_labels_may_not_be_used_for": [
      "architecture_selection",
      "threshold_selection",
      "confirmatory_training",
      "power_analysis_effect_hacking"
    ]
  },
  "environment": {
    "id": "robocasa/PickPlaceCounterToCabinet",
    "split": "target",
    "policy_manifest": "configs/policies/groot_n1_5_robocasa_atomic_seen_30p.json",
    "horizon": 750,
    "control_frequency_hz": 20,
    "action_chunk_length": 16
  },
  "episode_count": 36,
  "timing_contract": {
    "control_step_definition": "runner_loop_index_before_environment_step",
    "actuator_fault_phase": "before_action",
    "observation_fault_phase": "after_step",
    "observation_first_affected_input_offset_steps": 1,
    "onset_step_semantics": "first_policy_input_or_execution_affected_by_the_fault",
    "observation_injection_step_rule": "onset_step - 1",
    "minimum_observation_onset_step": 1,
    "early_termination_rule": "if an episode ends before first affected step, retain it as not_exposed attrition and never replace the seed"
  },
  "seed_block": {
    "seeds": [500, 501, 502, 503, 504, 505, 506, 507, 508, 509, 510, 511],
    "scene_seed_id_format": "pilot-v1.4-scene-{seed}",
    "scene_pair_id_format": "pilot-v1.4-scene-{seed}",
    "episode_id_format": "pilot-v1.4-scene-{seed}-{condition}",
    "episodes_per_seed": 3,
    "derived_condition_ids": ["clean", "actuator_fault", "observation_fault"]
  },
  "monitor_input_contract": {
    "allowed": [
      "previous_observation",
      "current_observation",
      "bounded_observation_history",
      "requested_action_chunk",
      "task_instruction"
    ],
    "forbidden": [
      "reward",
      "success",
      "terminated",
      "truncated",
      "fault_schedule",
      "fault_type",
      "executed_action",
      "mujoco_state"
    ]

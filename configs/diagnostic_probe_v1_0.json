{
  "protocol_version": "1.4",
  "probe_protocol_version": "1.0",
  "status": "pre_registered_diagnostic_probe_protocol",
  "scientific_result": false,
  "purpose": "test_whether_a_bounded_non_privileged_probe_adds_mechanism_information",
  "environment": {
    "id": "robocasa/PickPlaceCounterToCabinet",
    "split": "target",
    "control_frequency_hz": 20,
    "action_chunk_length": 16,
    "horizon": 750
  },
  "eligibility": {
    "trigger": "monitor_alarm_or_posterior_entropy_above_locked_threshold",
    "max_invocations_per_episode": 1,
    "no_fault_label_access": true,
    "no_reward_or_success_access": true,
    "no_executed_action_access": true,
    "clean_budget_counts_probe_as_intervention": true
  },
  "probe": {
    "name": "bounded_arm_hold_and_requery",
    "max_environment_steps": 4,
    "action_sequence": [
      {
        "step": 0,
        "operation": "reissue_current_chunk",
        "camera_subset": "all_declared_cameras"
      },
      {
        "step": 1,
        "operation": "requery_policy",
        "camera_subset": "all_declared_cameras"
      },
      {
        "step": 2,
        "operation": "continue",
        "camera_subset": "all_declared_cameras"
      },
      {
        "step": 3,
        "operation": "continue",
        "camera_subset": "all_declared_cameras"
      }
    ],
    "action_space_contract": "native_robocasa_structured_dict",
    "chunk_reset_after_probe": true,
    "probe_outputs": [
      "observation_delta",
      "requested_action_delta",
      "policy_requery_latency",
      "camera_temporal_consistency",
      "mechanism_posterior_delta"
    ]
  },
  "comparison": {
    "arms": ["passive_only", "passive_plus_probe"],
    "assignment": "episode_level_sha256_pair_randomization",
    "same_seed_pairing": true,
    "oracle_fault_type": "upper_bound_only",
    "recovery_selector": "disabled",
    "primary_probe_endpoint": "paired_change_in_mechanism_log_loss",
    "secondary_endpoints": [
      "balanced_accuracy",
      "macro_f1",
      "clean_false_intervention_rate",
      "additional_environment_steps",
      "policy_requery_count"
    ]
  },
  "cost_vector": {
    "extra_environment_steps_max": 4,
    "extra_compute_ms_max": 250,
    "human_help_count_max": 0,
    "risk_penalty_max": 0
  },
  "analysis": {
    "training_split": "monitor_training_v1_0.train_scene_seeds",
    "calibration_split": "monitor_training_v1_0.calibration_scene_seeds",
    "held_out_split": "monitor_training_v1_0.final_test_scene_seeds",
    "cluster_unit": "independent_scene_seed",
    "interval": "paired_cluster_bootstrap_95_percent",
    "multiple_comparison": "primary_probe_log_loss; others_secondary",
    "probe_is_not_recovery_evidence": true
  },
  "artifacts": {
    "manifest": "run_manifest.json",
    "episodes": "episodes.jsonl",
    "monitor_stream": "monitor_stream.jsonl",
    "audit_stream": "audit_stream.jsonl",
    "metrics": "metrics.json",
    "validation": "artifact_validation.json"
  },
  "gates": {
    "probe_must_not_run_before_monitor_calibration": true,
    "probe_must_be_compared_against_passive_only": true,
    "probe_cannot_unlock_recovery_without_cost_gate": true
  }
}
